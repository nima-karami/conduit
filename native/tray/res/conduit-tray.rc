#include <windows.h>

// TaskDialogIndirect lives only in Common Controls v6; without this the loader binds v5 and the exe dies with 0xC0000139.
1 RT_MANIFEST "conduit-tray.manifest"

101 ICON "normal.ico"
102 ICON "needs.ico"
103 ICON "warning.ico"

1 VERSIONINFO
FILEVERSION 0,58,0,0
PRODUCTVERSION 0,58,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Conduit\0"
      VALUE "FileDescription", "Conduit notification area helper\0"
      VALUE "FileVersion", "0.58.0\0"
      VALUE "InternalName", "conduit-tray\0"
      VALUE "OriginalFilename", "conduit-tray.exe\0"
      VALUE "ProductName", "Conduit\0"
      VALUE "ProductVersion", "0.58.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
