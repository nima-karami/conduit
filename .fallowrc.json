{
  "$schema": "https://docs.fallow.tools/schema/config.json",
  "entry": [
    "electron/main.ts",
    "electron/preload.ts",
    "server/main.ts",
    "server/supervise.ts",
    "webview/index.tsx",
    "webview/ts.worker.ts",
    "src/content-search-worker.ts",
    "tools/*.mjs",
    "esbuild.mjs",
    "test/unit/*.test.ts",
    "test/unit/*.test.tsx",
    "test/e2e/*.mjs",
    "test/e2e/stress/*.mjs",
    "resources/conduit-mcp/*.cjs",
    "test/e2e/fixtures/*.cjs"
  ],
  "ignoreDependencies": ["electron-updater", "dompurify"],
  "ignorePatterns": ["out/**", "dist/**", "designs/**", "node_modules/**"],
  "ignoreExports": [
    {
      "file": "src/protocol.ts",
      "exports": ["*"]
    },
    {
      "file": "webview/view-model.ts",
      "exports": ["*"]
    },
    {
      "file": "src/types.ts",
      "exports": ["*"]
    },
    {
      "file": "src/contracts/*.ts",
      "exports": ["*"]
    },
    {
      "file": "src/hc-client/index.ts",
      "exports": ["resolveHcEndpoint"]
    }
  ],
  "usedClassMembers": [
    {
      "implements": "TerminalRuntime",
      "members": [
        "reconcile",
        "spawn",
        "discardLaunch",
        "beginStopping",
        "input",
        "resize",
        "facts",
        "get",
        "screen",
        "tailLines",
        "kill",
        "retire",
        "close",
        "on",
        "onHealth",
        "liveTerminals",
        "killSessions"
      ]
    },
    {
      "implements": "ScreenPort",
      "members": ["ensure", "keepTail", "release"]
    },
    {
      "implements": "AttentionPort",
      "members": ["forgetSession"]
    },
    {
      "extends": "Error",
      "members": ["reason"]
    },
    {
      "implements": "HcStream",
      "members": ["facts", "receive"]
    },
    {
      "implements": "RuntimeRing",
      "members": ["append", "gap", "resized", "launchStarted"]
    }
  ]
}
